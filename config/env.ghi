namespace arm092.config

import os "go:os"
import strconv "go:strconv"
import strings "go:strings"
import time "go:time"

func envReason(code string) string {
	switch code {
		case "invalid_name":
			return "invalid variable name"
		case "missing":
			return "required value is absent"
		case "empty":
			return "required value is blank"
		case "invalid_int":
			return "expected a decimal integer within native int bounds"
		case "invalid_bool":
			return "expected a boolean (true/false, t/f, or 1/0)"
		case "invalid_duration":
			return "expected a duration such as 250ms or 30s within int64 nanosecond bounds"
	}

	return "invalid configuration"
}

class EnvError extends Exception {
	private variableName string
	private reasonCode string

	constructor(name string, code string) {
		parent("Environment variable " + name + ": " + envReason(code))
		this.variableName = name
		this.reasonCode = code
	}

	public func Name() string {
		return this.variableName
	}
	public func Code() string {
		return this.reasonCode
	}
}

func envName(name string) {
	if name == "" || strings.ContainsAny(name, "=\x00") {
		throw new EnvError(name, "invalid_name")
	}
}

func envInt(name string, value string) int {
	try {
		return strconv.Atoi(value)
	} catch err GoError {
		throw new EnvError(name, "invalid_int")
	}
}

func envBool(name string, value string) bool {
	try {
		return strconv.ParseBool(value)
	} catch err GoError {
		throw new EnvError(name, "invalid_bool")
	}
}

func envDuration(name string, value string) time.Duration {
	try {
		return time.ParseDuration(value)
	} catch err GoError {
		throw new EnvError(name, "invalid_duration")
	}
}

class Env {
	constructor() {}

	public func String(name string, fallback string) string {
		envName(name)
		value, present := os.LookupEnv(name)
		if !present {
			return fallback
		}

		return value
	}

	public func RequiredString(name string) string {
		envName(name)
		value, present := os.LookupEnv(name)
		if !present {
			throw new EnvError(name, "missing")
		}
		if strings.TrimSpace(value) == "" {
			throw new EnvError(name, "empty")
		}

		return value
	}

	public func Int(name string, fallback int) int {
		envName(name)
		value, present := os.LookupEnv(name)
		if !present {
			return fallback
		}

		return envInt(name, value)
	}

	public func RequiredInt(name string) int {
		return envInt(name, this.RequiredString(name))
	}

	public func Bool(name string, fallback bool) bool {
		envName(name)
		value, present := os.LookupEnv(name)
		if !present {
			return fallback
		}

		return envBool(name, value)
	}

	public func RequiredBool(name string) bool {
		return envBool(name, this.RequiredString(name))
	}

	public func Duration(name string, fallback time.Duration) time.Duration {
		envName(name)
		value, present := os.LookupEnv(name)
		if !present {
			return fallback
		}

		return envDuration(name, value)
	}

	public func RequiredDuration(name string) time.Duration {
		return envDuration(name, this.RequiredString(name))
	}
}
