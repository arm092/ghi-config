namespace tests

import arm092.config.Env
import arm092.config.EnvError
import os "go:os"
import strings "go:strings"
import testing "go:testing"
import time "go:time"

func absent(t *testing.T, name string) {
	t.Setenv(name, "temporary")
	os.Unsetenv(name)
}

func expectError(t *testing.T, name string, code string, secret string, action func()) {
	caught := false
	try {
		action()
	} catch err EnvError {
		caught = true
		if err.Name() != name || err.Code() != code || !strings.Contains(err.Error(), name) {
			t.Fatal("missing variable name or wrong error code")
		}
		if secret != "" &&(strings.Contains(err.Error(), secret) || strings.Contains(err.message, secret)) {
			t.Fatal("environment value leaked in error")
		}
	}
	if !caught {
		t.Fatal("expected EnvError")
	}
}

func TestDefaultsApplyOnlyWhenAbsent(t *testing.T) {
	name := "GHI_CONFIG_TEST_DEFAULT"
	absent(t, name)
	env := new Env()
	if env.String(name, "fallback") != "fallback" || env.Int(name, 42) != 42 || !env.Bool(name, true) || env.Duration(name, 3 * time.Second) != 3 * time.Second {
		t.Fatal("absent value did not use typed default")
	}
	t.Setenv(name, "")
	if env.String(name, "fallback") != "" {
		t.Fatal("empty string incorrectly used default")
	}
	expectError(t, name, "invalid_int", "", func() {
		env.Int(name, 42)
	})
	expectError(t, name, "invalid_bool", "", func() {
		env.Bool(name, true)
	})
	expectError(t, name, "invalid_duration", "", func() {
		env.Duration(name, time.Second)
	})
}

func TestStringsPreserveOriginalText(t *testing.T) {
	name := "GHI_CONFIG_TEST_TEXT"
	value := "  Հայ🙂 secret \n "
	t.Setenv(name, value)
	env := new Env()
	if env.String(name, "fallback") != value || env.RequiredString(name) != value {
		t.Fatal("string was trimmed or converted")
	}
}

func TestRequiredMethodsRejectMissing(t *testing.T) {
	name := "GHI_CONFIG_TEST_MISSING"
	absent(t, name)
	env := new Env()
	expectError(t, name, "missing", "", func() {
		env.RequiredString(name)
	})
	expectError(t, name, "missing", "", func() {
		env.RequiredInt(name)
	})
	expectError(t, name, "missing", "", func() {
		env.RequiredBool(name)
	})
	expectError(t, name, "missing", "", func() {
		env.RequiredDuration(name)
	})
}

func TestRequiredMethodsRejectBlank(t *testing.T) {
	name := "GHI_CONFIG_TEST_BLANK"
	env := new Env()
	for _, value := range []string{
		"",
		" \t\n\u2003",
	} {
		t.Setenv(name, value)
		expectError(t, name, "empty", "", func() {
			env.RequiredString(name)
		})
		expectError(t, name, "empty", "", func() {
			env.RequiredInt(name)
		})
		expectError(t, name, "empty", "", func() {
			env.RequiredBool(name)
		})
		expectError(t, name, "empty", "", func() {
			env.RequiredDuration(name)
		})
	}
}

func TestIntegerParsingAndZero(t *testing.T) {
	name := "GHI_CONFIG_TEST_INT"
	env := new Env()
	t.Setenv(name, "0")
	if env.Int(name, 42) != 0 || env.RequiredInt(name) != 0 {
		t.Fatal("zero used default")
	}
	t.Setenv(name, "-17")
	if env.Int(name, 42) != - 17 || env.RequiredInt(name) != - 17 {
		t.Fatal("signed integer failed")
	}
	t.Setenv(name, "+007")
	if env.Int(name, 42) != 7 {
		t.Fatal("decimal integer parsing failed")
	}
}

func TestIntegerErrorsNeverLeakInput(t *testing.T) {
	name := "GHI_CONFIG_TEST_INT_SECRET"
	env := new Env()
	for _, value := range []string{
		"int-secret-731",
		"123456789012345678901234567890",
		" 17",
		"0x10",
		"1.5",
	} {
		t.Setenv(name, value)
		expectError(t, name, "invalid_int", value, func() {
			env.Int(name, 42)
		})
		expectError(t, name, "invalid_int", value, func() {
			env.RequiredInt(name)
		})
	}
}

func TestBooleanSpellingsAndFalse(t *testing.T) {
	name := "GHI_CONFIG_TEST_BOOL"
	env := new Env()
	for _, value := range []string{
		"1",
		"t",
		"T",
		"true",
		"TRUE",
		"True",
	} {
		t.Setenv(name, value)
		if !env.Bool(name, false) || !env.RequiredBool(name) {
			t.Fatal("true rejected")
		}
	}
	for _, value := range []string{
		"0",
		"f",
		"F",
		"false",
		"FALSE",
		"False",
	} {
		t.Setenv(name, value)
		if env.Bool(name, true) || env.RequiredBool(name) {
			t.Fatal("false used default")
		}
	}
}

func TestBooleanErrorsNeverLeakInput(t *testing.T) {
	name := "GHI_CONFIG_TEST_BOOL_SECRET"
	env := new Env()
	for _, value := range []string{
		"bool-secret-918",
		"yes",
		" true",
		"TrUe",
	} {
		t.Setenv(name, value)
		expectError(t, name, "invalid_bool", value, func() {
			env.Bool(name, true)
		})
		expectError(t, name, "invalid_bool", value, func() {
			env.RequiredBool(name)
		})
	}
}

func TestDurationUnitsAndZero(t *testing.T) {
	name := "GHI_CONFIG_TEST_DURATION"
	env := new Env()
	t.Setenv(name, "1m30.5s")
	if env.Duration(name, time.Second) != 90500 * time.Millisecond || env.RequiredDuration(name) != 90500 * time.Millisecond {
		t.Fatal("compound duration failed")
	}
	t.Setenv(name, "0")
	if env.Duration(name, time.Second) != 0 || env.RequiredDuration(name) != 0 {
		t.Fatal("zero duration used default")
	}
	t.Setenv(name, "-2s")
	if env.Duration(name, time.Second) != - 2 * time.Second {
		t.Fatal("negative duration rejected")
	}
}

func TestDurationErrorsNeverLeakInput(t *testing.T) {
	name := "GHI_CONFIG_TEST_DURATION_SECRET"
	env := new Env()
	for _, value := range []string{
		"duration-secret-614",
		"15",
		"999999999999999999h",
		" 1s",
	} {
		t.Setenv(name, value)
		expectError(t, name, "invalid_duration", value, func() {
			env.Duration(name, time.Second)
		})
		expectError(t, name, "invalid_duration", value, func() {
			env.RequiredDuration(name)
		})
	}
}

func TestInvalidNamesFailBeforeUsingDefault(t *testing.T) {
	env := new Env()
	for _, name := range []string{
		"",
		"BAD=NAME",
		"BAD\x00NAME",
	} {
		expectError(t, name, "invalid_name", "", func() {
			env.String(name, "fallback")
		})
		expectError(t, name, "invalid_name", "", func() {
			env.RequiredString(name)
		})
		expectError(t, name, "invalid_name", "", func() {
			env.Int(name, 42)
		})
		expectError(t, name, "invalid_name", "", func() {
			env.Bool(name, true)
		})
		expectError(t, name, "invalid_name", "", func() {
			env.Duration(name, time.Second)
		})
	}
}

func TestLoaderReadsEnvironmentOnEachCall(t *testing.T) {
	name := "GHI_CONFIG_TEST_FRESH"
	env := new Env()
	t.Setenv(name, "1")
	if env.RequiredInt(name) != 1 {
		t.Fatal("initial value missing")
	}
	t.Setenv(name, "2")
	if env.RequiredInt(name) != 2 {
		t.Fatal("loader cached stale value")
	}
}
